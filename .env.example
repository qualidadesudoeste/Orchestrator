# Aplicação
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
VITE_APP_ID=orchestrator-local

# Banco MySQL
DATABASE_URL=mysql://orchestrator:troque_a_senha@localhost:3306/orchestrator

# Autenticação local — gere um valor aleatório longo para cada ambiente
JWT_SECRET=substitua_por_um_segredo_aleatorio_com_pelo_menos_32_caracteres
# Chave dedicada para criptografar senhas dos ambientes de teste (recomendado).
# Se omitida no ambiente local, o sistema utiliza JWT_SECRET.
CREDENTIAL_ENCRYPTION_KEY=substitua_por_outra_chave_aleatoria_com_pelo_menos_32_caracteres

# Token interno usado para assinar downloads e proteger endpoints do agente
QA_AGENT_API_TOKEN=substitua_por_um_token_aleatorio_com_pelo_menos_32_caracteres
ORCHESTRATOR_PUBLIC_URL=http://localhost:3000

# Operação HTTP. Em produção, confie apenas na quantidade real de proxies.
TRUST_PROXY=false
JSON_BODY_LIMIT=10mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=600
RATE_LIMIT_LOGIN_MAX=10
SHUTDOWN_TIMEOUT_MS=10000

# IA — OpenAI API (a assinatura do ChatGPT não inclui créditos da API)
OPENAI_API_KEY=
LLM_API_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-5.6-terra

# Compatibilidade legada para outros serviços Forge (opcional)
BUILT_IN_FORGE_API_URL=https://api.openai.com
BUILT_IN_FORGE_API_KEY=

# OAuth legado (opcional; a autenticação local é o fluxo atual)
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_OAUTH_PORTAL_URL=

# Integrações visuais opcionais
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
